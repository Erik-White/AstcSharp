<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\AstcSharp\AstcSharp.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AstcEncoderCSharp" Version="5.3.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstcSharp\AstcSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AstcSharp.Tests\Utils\StreamCodec.cs" Link="Utils\StreamCodec.cs" />
    <Compile Include="..\AstcSharp.Tests\Utils\TestImage.cs" Link="Utils\TestImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Copy test data into the output directory. -->
  <Target Name="CopyTestData" AfterTargets="Build">
    <ItemGroup>
      <_TestData Include="..\AstcSharp.Tests\TestData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestData)"
          DestinationFiles="@(_TestData -> '$(TargetDir)TestData\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy AstcEncoderCSharp native runtimes to the output directory.
       The package uses a custom DLL import resolver that expects native libs
       under runtimes/<os>/<arch>/ relative to the assembly directory, which
       does not match the standard NuGet runtimes/<rid>/native layout, so the
       SDK does not copy them automatically. -->
  <Target Name="CopyAstcEncNativeRuntimes" AfterTargets="Build">
    <ItemGroup>
      <_AstcEncNativeFiles Include="$(NuGetPackageRoot)\astcencodercsharp\5.3.0\runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AstcEncNativeFiles)"
          DestinationFiles="@(_AstcEncNativeFiles -> '$(TargetDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
