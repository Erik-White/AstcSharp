<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\AstcSharp\AstcSharp.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstcSharp\AstcSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="AstcEncoderCSharp" Version="5.3.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);HAS_ARM_REFERENCE</DefineConstants>
  </PropertyGroup>

  <!-- Copy the reference testdata (astc-codec testdata) into the test output
       so the runtime path used by the tests (Path.Combine("AstcSharp.Reference", ...))
       resolves correctly regardless of the test runner's working directory. -->
  <Target Name="CopyReferenceTestData" AfterTargets="Build">
    <ItemGroup>
    <_ReferenceTestData Include="..\AstcSharp.Reference\astc-codec\**\*.*" />
    <_TestData Include="TestData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ReferenceTestData)" DestinationFiles="@( _ReferenceTestData -> '$(TargetDir)AstcSharp.Reference\\astc-codec\\%(RecursiveDir)%(Filename)%(Extension)')" />
          <Copy SourceFiles="@(_TestData)" DestinationFiles="@(_TestData -> '$(TargetDir)TestData\\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Copy AstcEncoderCSharp native runtimes to the output directory.
       The package uses a custom DLL import resolver that expects native libs
       under runtimes/<os>/<arch>/ relative to the assembly directory. -->
  <Target Name="CopyAstcEncNativeRuntimes" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <_AstcEncNativeFiles Include="$(NuGetPackageRoot)astcencodercsharp\5.3.0\runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AstcEncNativeFiles)"
          DestinationFiles="@(_AstcEncNativeFiles -> '$(TargetDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
